def resolverSistemaHomogeneo(A, tol=1e-15, Kiter=1e5):
    S = productoMatricial(traspuesta(A), A, 0.0)     # (n x n) simétrica
    P, D = diagRHSVD(S, tol, Kiter)
    indice = 0
    for i in range(1, S.shape[0]):
        if D[i, i] < D[indice, indice]:
            indice = i
    return P[:, indice]

def svd(A, tol=1e-15, Kiter=1e5):
    m, n = A.shape
    S = productoMatricial(traspuesta(A), A, 0.0)
    V, D = diagRHSVD(S, tol, Kiter)
    orden = sorted(range(n), key=lambda i: -D[i, i])     # de mayor a menor
    sig = np.zeros(n)
    Vo = np.zeros((n, n))
    for k, i in enumerate(orden):
        lam = D[i, i]
        if lam < 0:                  # redondeo: evita sqrt de un negativo
            lam = 0.0
        sig[k] = np.sqrt(lam)
        Vo[:, k] = V[:, i]
    B = productoMatricial(A, Vo, 0.0)
    U = np.zeros((m, n))
    for k in range(n):
        if sig[k] > tol:
            U[:, k] = B[:, k] / sig[k]
    return U, sig, Vo
    
    
    
Dos cambios importantes:

Siempre se diagonaliza AᵀA, que es n×n, sea cual sea la forma de A.
El 0.0 en productoMatricial evita que se pongan en cero productos chicos (el problema de atol que vimos con las columnas de A).


Con m < n, esta svd devuelve n valores singulares (el último ~0) en lugar de m, que es lo que hace falta para tener el vector del núcleo. Por eso el test acepta que haya más valores siempre que los sobrantes sean ≈ 0.


